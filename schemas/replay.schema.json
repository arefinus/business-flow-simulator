{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arefinus/business-flow-simulator/schemas/replay.schema.json",
  "title": "Replay",
  "description": "Replay file consumed by the portfolio's 3D business scene. Synthetic demo only.",
  "type": "object",
  "required": ["schemaVersion", "scenarioId", "mode", "nodes", "edges", "events"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "scenarioId": {"type": "string"},
    "mode": {"const": "synthetic-demo"},
    "policy": {"type": "string"},
    "seed": {"type": "integer"},
    "label": {"const": "synthetic"},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "type", "label"], "additionalProperties": false,
                "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "label": {"type": "string"}}}
    },
    "edges": {
      "type": "array",
      "items": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
                "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}
    },
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "id", "correlationId", "from", "to", "state", "status"],
        "additionalProperties": false,
        "properties": {
          "t": {"type": "integer", "minimum": 0},
          "id": {"type": "string"},
          "correlationId": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "state": {"type": "string", "enum": ["purchase_order", "fulfillment", "invoice", "payment_review", "settlement", "reporting", "cancelled"]},
          "status": {"type": "string", "enum": ["ok", "partial", "delayed", "failed", "exception", "escalated", "cancelled", "rejected"]}
        }
      }
    }
  }
}
