{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arefinus/business-flow-simulator/schemas/event.schema.json",
  "title": "Event",
  "description": "One immutable fact in the workflow event log. Money fields inside payload are integer cents of a fictional USD scenario.",
  "type": "object",
  "required": ["schema_version", "id", "t", "timestamp", "correlation_id", "version", "actor_type", "to_actor", "event_type", "state", "status", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^SYN-EV-[0-9]{7}$"},
    "t": {"type": "integer", "minimum": 0, "description": "simulated minutes since the fictional epoch"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "correlation_id": {"type": "string", "pattern": "^SYN-(PO|REPL)-[0-9]+$"},
    "version": {"type": "integer", "minimum": 1, "description": "1-based position inside the correlation stream"},
    "actor_type": {"type": "string", "enum": ["supplier", "manufacturer", "warehouse", "retailer", "customer", "invoice_payment_service", "review_queue"]},
    "to_actor": {"type": "string", "enum": ["supplier", "manufacturer", "warehouse", "retailer", "customer", "invoice_payment_service", "review_queue"]},
    "event_type": {"type": "string", "enum": [
      "purchase_order_placed", "inventory_reserved", "replenishment_ordered", "supply_dispatched",
      "replenishment_shipped", "replenishment_arrived", "shipment_dispatched", "shipment_delayed",
      "shipment_arrived", "invoice_issued", "three_way_match", "auto_resolved", "review_enqueued",
      "review_escalated", "review_resolved", "invoice_rejected", "payment_attempted",
      "payment_retry_scheduled", "settled", "reported", "order_cancelled", "compensation_applied"]},
    "state": {"type": "string", "enum": ["purchase_order", "fulfillment", "invoice", "payment_review", "settlement", "reporting", "cancelled"]},
    "status": {"type": "string", "enum": ["ok", "partial", "delayed", "failed", "exception", "escalated", "cancelled", "rejected"]},
    "payload": {
      "type": "object",
      "required": ["cost_cents"],
      "properties": {
        "cost_cents": {"type": "integer", "minimum": 0},
        "amount_cents": {"type": "integer", "minimum": 0},
        "invoice_amount_cents": {"type": "integer", "minimum": 0},
        "po_amount_cents": {"type": "integer", "minimum": 0}
      }
    }
  }
}
