{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arefinus/business-flow-simulator/schemas/kpi.schema.json",
  "title": "KPI row",
  "description": "One row of the KPI report: one scenario under one policy. Every value is demo output of a synthetic run; the evidence_label is always 'demo'.",
  "type": "object",
  "required": ["scenario_id", "policy", "seed", "evidence_label", "total_orders", "completed_orders", "cancelled_orders", "incomplete_orders", "cycle_time_median_minutes", "cycle_time_p95_minutes", "exception_rate", "exceptions_total", "review_items", "auto_resolutions", "escalations", "review_backlog_max", "review_backlog_mean", "review_backlog_final", "stockout_count", "replenishments", "partial_shipment_orders", "duplicate_invoices_detected", "duplicate_event_ids_ignored", "processing_cost_cents", "events_total", "inventory_conserved", "cash_conserved"],
  "properties": {
    "scenario_id": {"type": "string"},
    "policy": {"type": "string", "enum": ["manual", "rules_automation", "capacity_limited_review"]},
    "seed": {"type": "integer"},
    "evidence_label": {"const": "demo"},
    "total_orders": {"type": "integer", "minimum": 0},
    "completed_orders": {"type": "integer", "minimum": 0},
    "cancelled_orders": {"type": "integer", "minimum": 0},
    "incomplete_orders": {"type": "integer", "minimum": 0},
    "cycle_time_median_minutes": {"type": ["number", "null"]},
    "cycle_time_p95_minutes": {"type": ["number", "null"]},
    "exception_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "exceptions_total": {"type": "integer", "minimum": 0},
    "review_items": {"type": "integer", "minimum": 0},
    "auto_resolutions": {"type": "integer", "minimum": 0},
    "escalations": {"type": "integer", "minimum": 0},
    "review_backlog_max": {"type": "integer", "minimum": 0},
    "review_backlog_mean": {"type": "number", "minimum": 0},
    "review_backlog_final": {"type": "integer", "minimum": 0},
    "stockout_count": {"type": "integer", "minimum": 0},
    "replenishments": {"type": "integer", "minimum": 0},
    "partial_shipment_orders": {"type": "integer", "minimum": 0},
    "duplicate_invoices_detected": {"type": "integer", "minimum": 0},
    "duplicate_event_ids_ignored": {"type": "integer", "minimum": 0},
    "processing_cost_cents": {"type": "integer", "minimum": 0},
    "events_total": {"type": "integer", "minimum": 0},
    "inventory_conserved": {"type": "boolean"},
    "cash_conserved": {"type": "boolean"}
  }
}
